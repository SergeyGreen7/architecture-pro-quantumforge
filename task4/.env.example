# Telegram secrets from @BotFather and setWebhook.
TELEGRAM_BOT_TOKEN=123456789:replace_me
TELEGRAM_WEBHOOK_SECRET=replace_with_random_letters_digits_dash_or_underscore

# Yandex Cloud AI Studio credentials.
YANDEX_FOLDER_ID=b1g_replace_me
YANDEX_API_KEY=AQVN_replace_me
YANDEX_MODEL=yandexgpt-5.1

# Local retrieval. Paths are resolved from the task4 directory.
RAG_INDEX_DIR=../task3/chroma_db
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_CACHE_DIR=../task2/embedding_model_cache
EMBEDDING_DEVICE=auto
RAG_TOP_K=3
RAG_MIN_SIMILARITY=0.45
RAG_MAX_CONTEXT_CHARS=9000
RAG_MAX_QUERY_CHARS=2000

# Structured JSONL logs. Local files rotate at 5 MiB and keep five backups.
LOG_DIR=./storage/logs
LOG_LEVEL=INFO
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
